{
  "name": "hermes-plexus",
  "version": "0.2.0",
  "description": "Hermes Desktop plugin: a local markdown vault as a note constellation, with file tree and tabbed editor in one workspace tab.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/build.mjs && node scripts/deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.20.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vscode/codicons": "0.0.45",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "marked": "16.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
